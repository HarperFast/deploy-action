{
	"name": "Allow Harper previews",
	"enforcement": "active",
	"conditions": {
		"workflow_path": {
			"include": [".github/workflows/preview.yaml"],
			"exclude": []
		}
	},
	"rules": [
		{
			"type": "restrict_action_events",
			"parameters": {
				"allowed_events": ["pull_request_target"]
			}
		}
	]
}
